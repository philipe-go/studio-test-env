# Copy this file to .env and replace every example password.
SERVER_HOSTNAME=YOUR-WINDOWS-HOSTNAME
HTTP_PORT=80

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-this-mongo-password
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-this-mongo-express-password

REDIS_PASSWORD=change-this-redis-password

MYSQL_ROOT_PASSWORD=change-this-mysql-password
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=change-this-mysql-user-password

P4D_PORT=host.docker.internal:1666
P4D_SUPER=super
P4D_SUPER_PASSWD=change-this-p4-super-password
SWARM_USER=swarm
SWARM_PASSWD=change-this-swarm-password
SWARM_HOST=YOUR-WINDOWS-HOSTNAME.swarm.com
